{
  "name": "teamulate-website-rebuild",
  "version": "0.1.0",
  "private": true,
  "description": "Teamulate public website rebuild. Contains the preview-only AI Card v1 (guided, deterministic sample).",
  "scripts": {
    "dev": "next dev",
    "dev:preview": "NEXT_PUBLIC_AI_CARD_PREVIEW=true next dev",
    "build": "next build",
    "build:preview": "NEXT_PUBLIC_AI_CARD_PREVIEW=true next build",
    "start": "next start",
    "serve:out": "npx serve out -l 4173",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "screenshots": "playwright test -c playwright.config.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build:preview"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
